# SideRail official runtime configuration.
# Mount the Railway/Compose persistent volume at /var/lib/marzban.
PORT=8080
NODE_ENV=production
SIDERAIL_DATA_DIR=/var/lib/marzban/siderail
CORE_DIR=/var/lib/marzban/siderail/core
CORE_VERSION=v26.9.9
CORE_API_PORT=10085
CORE_INBOUND_BASE_PORT=20000
# Optional: use a long random value; if omitted SideRail persists a generated secret in its data directory.
JWT_SECRET=
# Only needed for local Compose/Caddy.
PANEL_DOMAIN=panel.example.com
